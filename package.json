{
  "name": "camperplan",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "preflight": "bash ./scripts/dev-preflight.sh",
    "start": "npm run preflight && env -u CI EXPO_NO_DOCTOR=1 expo start --tunnel --port 8083",
    "start:clean": "npm run preflight && env -u CI EXPO_NO_DOCTOR=1 expo start -c --tunnel --port 8083",
    "start:lan": "npm run preflight && env -u CI EXPO_NO_DOCTOR=1 expo start --host lan --port 8083",
    "stop": "killall node 2>/dev/null || true",
    "doctor": "npx expo-doctor",
    "release:check": "npm run doctor && npx tsc --noEmit",
    "test:dvla": "node scripts/test-dvla-reg.mjs",
    "android": "npm run preflight && env -u CI EXPO_NO_DOCTOR=1 expo start --android --port 8083",
    "ios": "npm run preflight && env -u CI EXPO_NO_DOCTOR=1 expo start --ios --port 8083",
    "web": "EXPO_OFFLINE=1 EXPO_NO_DOCTOR=1 expo export --platform web --output-dir dist",
    "web:dev": "EXPO_OFFLINE=1 EXPO_NO_DOCTOR=1 expo start --web",
    "eas:whoami": "eas whoami",
    "eas:init": "eas build:configure",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "submit:ios:production": "eas submit --platform ios --profile production",
    "release:ios:testflight": "npm run build:ios:preview",
    "release:ios:appstore": "npm run build:ios:production && npm run submit:ios:production",
    "release:audit": "scripts/release/access-audit.sh",
    "release:backend": "scripts/release/deploy-backend.sh",
    "release:ios:script:testflight": "scripts/release/ios-release.sh testflight",
    "release:ios:script:appstore": "scripts/release/ios-release.sh appstore",
    "catalog:import": "node scripts/import-catalog.mjs",
    "catalog:import:downloads": "node scripts/import-catalog.mjs \"/Users/danandrews/Downloads/Crafted Campers.xlsx\"",
    "catalog:test": "tsx --tsconfig tsconfig.json scripts/catalog-integrity.ts",
    "catalog:validate": "npm run catalog:import:downloads && npm run catalog:test && npx tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "@stripe/stripe-react-native": "0.50.3",
    "@supabase/supabase-js": "^2.97.0",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-av": "^16.0.8",
    "expo-blur": "^15.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-mail-composer": "~15.0.8",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.10",
    "lottie-react-native": "^7.3.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "eas-cli": "^18.4.0",
    "react-test-renderer": "19.1.0",
    "supabase": "^2.84.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vercel": "^50.37.3"
  },
  "private": true
}
